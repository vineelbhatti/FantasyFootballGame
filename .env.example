# Copy this file to .env, replace the placeholder values, then load it:
#   set -a; source .env; set +a
# Never commit the resulting .env file.

# Generate a strong value, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
FLASK_SECRET_KEY=replace-with-a-random-secret

# Key used by main.py for the Tenor GIF API.
TENOR_API_KEY=replace-with-your-tenor-api-key

# Key used by Temp.py and Test.py for the GIPHY API.
GIPHY_API_KEY=replace-with-your-giphy-api-key
